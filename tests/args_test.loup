@mode(host.dual)

# Unit tests for rm's command-line parsing (source/cli/args.loup): short
# and long options, the --preserve-root forms, `--` and errors.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, match_long);

func test_defaults(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.force and !opts.recursive and !opts.dir and !opts.verbose, "no flags");
    expect(opts.preserve_root, "--preserve-root is the default");
}

func test_short_options(): void {
    let opts = parse_args(["-rfdv", "x"]).unwrap();
    expect(opts.recursive and opts.force and opts.dir and opts.verbose, "-r -f -d -v");
    expect(parse_args(["-R"]).unwrap().recursive, "-R");
}

func test_long_options(): void {
    let opts = parse_args(["--force", "--recursive", "--dir", "--verbose"]).unwrap();
    expect(opts.force and opts.recursive and opts.dir and opts.verbose, "long forms");
    expectEq(match_long("rec").unwrap(), "recursive", "prefix");
    expectEq(match_long("no").unwrap(), "no-preserve-root", "--no");
}

func test_preserve_root_options(): void {
    expect(!parse_args(["--no-preserve-root"]).unwrap().preserve_root, "--no-preserve-root");
    expect(parse_args(["--no-preserve-root", "--preserve-root"]).unwrap().preserve_root, "last wins");
    expect(parse_args(["--no-preserve-root", "--preserve-root=all"]).unwrap().preserve_root, "=all");
    expectEq(parse_args(["--preserve-root=x"]).unwrap_err(), "unrecognized --preserve-root argument: 'x'", "=x");
}

func test_operands_and_double_dash(): void {
    let opts = parse_args(["a", "-v", "b"]).unwrap();
    expect(opts.verbose, "options anywhere");
    expectEq(opts.operands.len(), 2, "two operands");
    let literal = parse_args(["--", "-f"]).unwrap();
    expect(!literal.force, "-f after -- is a name");
    expectEq(literal.operands[0], "-f", "operand");
}

func test_errors(): void {
    expectEq(parse_args(["-i", "a"]).unwrap_err(), "invalid option -- 'i'", "-i is not supported");
    expectEq(parse_args(["--bogus"]).unwrap_err(), "unrecognized option '--bogus'", "unknown");
    expectEq(parse_args(["--force=1"]).unwrap_err(), "option '--force' doesn't allow an argument", "argument");
}
