@mode(host.dual)

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        i"Usage: {$ APP_NAME $} [OPTION]... [FILE]...",
        "Remove (unlink) the FILE(s).",
        "",
        "  -f, --force           ignore nonexistent files and arguments",
        "      --no-preserve-root  do not treat '/' specially",
        "      --preserve-root[=all]  do not remove '/' (default)",
        "  -r, -R, --recursive   remove directories and their contents recursively",
        "  -d, --dir             remove empty directories",
        "  -v, --verbose         explain what is being done",
        "      --help        display this help and exit",
        "      --version     output version information and exit",
        "",
        "By default, rm does not remove directories.  Use the --recursive (-r or -R)",
        "option to remove each listed directory, too, along with all of its contents.",
        "",
        "Symbolic links are removed, never followed. rm never asks for",
        "confirmation (there is no -i or -I).",
        "",
        "To remove a file whose name starts with a '-', for example '-foo',",
        "use one of these commands:",
        i"  {$ APP_NAME $} -- -foo",
        "",
        i"  {$ APP_NAME $} ./-foo",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
