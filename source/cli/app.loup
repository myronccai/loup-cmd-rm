@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.rm import (run_rm);

# Whether a parse error is followed by the "Try 'rm --help'" line; GNU rm
# omits it after a bad --preserve-root argument.
pub func wants_try(msg: string): bool {
    return !msg.startsWith("unrecognized --preserve-root argument");
}

# Parses argv, runs rm and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            if (wants_try(msg)) {
                printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            }
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_rm(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
