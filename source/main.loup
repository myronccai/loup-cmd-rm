@mode(host.dual)

# rm: entry point of the Loup recreation of GNU rm. Keep this file thin: all
# behaviour lives in cli.app.run so that tests can call it with an argument
# list.
#
# Runtime: host.dual. The entry point: main() gets the command line. The same
# source runs two ways: `make build` compiles it with the rest of source/
# into the native binary build/rm, which `make e2e` then tests, and
# `make run` interprets it with Stage0 (`loup-bootstrap run
# source/main.loup`). Not with the self-hosted `loup run`: there listDir
# leaves out dot-files and io.fs's remove and removeDir run the system's
# `rm -f` and `rm -rf`, so `rm -d` would remove a directory that holds
# only dot-files.

from cli.app import (run);

func main(): int {
    return run(runtime.args());
}
