@mode(host.dual)

# Application identity and exit statuses of rm. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants compiled into the native binary build/rm by
# `make build`; `loup run source/main.loup` and the unit tests (`make test`,
# Stage0) use the same definitions.

pub const APP_NAME: string = "rm";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Remove files and directories (a Loup recreation of GNU rm).";

# Exit statuses returned by main(). GNU rm uses 1 for every failure, usage
# errors included.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
